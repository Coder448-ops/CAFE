# --- LOLA CAFE environment configuration ---------------------------------
# Absolute or relative path to the SQLite database file (created automatically).
LOLA_DB_PATH=./data/lola.db

# Secret used to sign customer table-device cookies and other HMACs.
# REQUIRED in production. Generate with: openssl rand -hex 32
LOLA_SECRET=change-me-to-a-32-byte-random-hex-string

# Set to "production" in a real deployment (enables secure cookies + HSTS).
NODE_ENV=development

# Bootstrap admin credentials used ONLY by `npm run admin:create`.
# Never commit real values; never ship them to the browser.
ADMIN_EMAIL=admin@lolacafe.uz
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
